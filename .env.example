# Public Supabase values (safe for the browser; RLS remains mandatory)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Server-only. Used only by setup/demo scripts; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Initial administrator, consumed by `npm run admin:create`.
ADMIN_INITIAL_EMAIL=gestao@adimimoveis.com.br
ADMIN_INITIAL_PASSWORD=defina-a-senha-inicial-aqui
ADMIN_INITIAL_NAME=Direção Adim

# Optional Playwright credentials for authenticated integration tests.
E2E_ADMIN_EMAIL=gestao@adimimoveis.com.br
E2E_ADMIN_PASSWORD=
E2E_BASE_URL=http://127.0.0.1:3000
E2E_MANAGER_NAME=Gestora E2E
E2E_MANAGER_EMAIL=gestora.e2e@adimimoveis.com.br
